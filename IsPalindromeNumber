package testleafCode;

import java.util.Scanner;

public class IsPalindromeNumber {

	public static void main(String[] args) 
	{
		// TODO Auto-generated method stub
		System.out.println("Palindrome Program");
		Scanner sc= new Scanner(System.in);
		int input = sc.nextInt();
		int original= input;
		int output = 0,rem;
		//int len = String.valueOf(input).length();
		//for(int i=len-1;i>=0;i--)
		while(input>0)
		{
			rem=input%10;
			output=(output*10)+rem;
			input=input/10;
		}
		System.out.println("reversednumber "+ output);
		
		if(original == output)
		{
			System.out.println("IS palindrome"+ output);
			System.out.println(".........");
		}
		else {
			System.out.println("Is not a palindrome "+ output);
		}
	}

}
